# Public URL of the dashboard, as seen by the browser (used for the OIDC redirect URI).
# Register  ${APP_URL}/api/auth/callback  as the redirect URI in your identity provider.
APP_URL=https://homelab.example.com

# OpenID Connect provider (must expose /.well-known/openid-configuration).
OIDC_ISSUER=https://auth.example.com/application/o/homelab/
OIDC_CLIENT_ID=homelab-web
OIDC_CLIENT_SECRET=change-me
OIDC_SCOPES=openid profile email
# Optional comma-separated allow-list (email, preferred_username or sub). Empty = anyone your IdP lets in.
OIDC_ALLOWED_USERS=

# Random strings of at least 32 characters, e.g. `openssl rand -base64 48`.
# SESSION_SECRET signs the session cookie; HOMELAB_ENCRYPTION_KEY encrypts the stored service credentials.
# Keep HOMELAB_ENCRYPTION_KEY stable: changing it makes the saved credentials unreadable.
SESSION_SECRET=
HOMELAB_ENCRYPTION_KEY=

# Where the SQLite database lives (the Docker image uses /data, mount a volume there).
# DATA_DIR=/data
